# NOORE environment template.
# Copy to `.env.local` and fill in real values. Never commit `.env*` files.

# Supabase project URL. Public — safe for the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public anon key. Public — safe for the browser (NEXT_PUBLIC_).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER-ONLY. NEVER expose in browser code or
# prefix with NEXT_PUBLIC_. Used by later backend phases for privileged tasks.
SUPABASE_SERVICE_ROLE_KEY=
